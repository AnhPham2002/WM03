{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Boot",
            "type": "cortex-debug",
            "request": "launch",

            "cwd": "${workspaceFolder}",

            "executable":
                "${workspaceFolder}/build/Debug/Boot/WM03_BOOT.elf",

            "servertype": "stlink",
            "device": "STM32L431RCT6",
            "interface": "swd",

            "preLaunchTask": "debug",

            "gdbPath":
                "C:/Program Files/Arm/GNU Toolchain mingw-w64-x86_64-arm-none-eabi/bin/arm-none-eabi-gdb.exe"
        },

        {
            "name": "Debug App A",
            "type": "cortex-debug",
            "request": "launch",

            "cwd": "${workspaceFolder}",

            "executable":
                "${workspaceFolder}/build/Debug/App_a/WM03_APP_A.elf",

            "servertype": "stlink",
            "device": "STM32L431RCT6",
            "interface": "swd",

            "preLaunchTask": "debug",

            "gdbPath":
                "C:/Program Files/Arm/GNU Toolchain mingw-w64-x86_64-arm-none-eabi/bin/arm-none-eabi-gdb.exe"
        }
    ]
}